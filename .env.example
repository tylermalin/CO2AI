# Database
DB_PASSWORD=carbon
DATABASE_URL=postgresql+asyncpg://carbon:carbon@localhost:5432/carbon_control
# Optional: read replica for read-only endpoints (emissions, health, etc.)
# DATABASE_READONLY_URL=postgresql+asyncpg://carbon_readonly:carbon@replica:5432/carbon_control

# Security (override in production)
JWT_SECRET=change-me-in-production

# Magic (passwordless auth) - get keys from https://dashboard.magic.link
MAGIC_SECRET_KEY=sk_test_...
# Frontend: VITE_MAGIC_PUBLISHABLE_KEY=pk_test_...

# External APIs
ELECTRICITYMAP_API_KEY=
OPENAI_API_KEY=

# Proxy / Carbon estimation (optional - defaults in config)
OPENAI_BASE_URL=https://api.openai.com/v1
HARDWARE_EFFICIENCY_FLOPS_PER_JOULE=1e11
CARBON_INTENSITY_G_PER_KWH=400
ELECTRICITYMAP_DEFAULT_ZONE=US-CAL-CISO
DEFAULT_MODEL_PARAMS=70000000000

# Multi-region upstream (JSON): [{"zone":"US-CAL-CISO","base_url":"https://api.openai.com/v1"},...]
# UPSTREAM_REGIONS=
